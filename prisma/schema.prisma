// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum PreferredLanguage {
  ru
  en

  @@map("preferred_language")
}

model User {
  id           BigInt  @id @default(autoincrement())
  name         String  @db.VarChar(100)
  email        String  @db.VarChar(255)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  bio          String? @db.VarChar(500)

  avatarObjectKey   String?           @map("avatar_object_key") @db.VarChar(500)
  preferredLanguage PreferredLanguage @default(en) @map("preferred_language")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  routes Route[]

  @@unique([email], map: "users_email_unique")
  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  slug      String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([name], map: "tags_name_unique")
  @@unique([slug], map: "tags_slug_unique")
  @@map("tags")
}

model Route {
  id     BigInt @id @default(autoincrement())
  userId BigInt @map("user_id")

  title                String  @db.VarChar(150)
  slug                 String  @db.VarChar(180)
  description          String? @db.Text
  coverObjectKey       String? @map("cover_object_key") @db.VarChar(500)
  totalDistanceMeters  Int?    @map("total_distance_meters")
  totalDurationSeconds Int?    @map("total_duration_seconds")

  routeGeometry Json?     @map("route_geometry")
  routeBuiltAt  DateTime? @map("route_built_at")
  isRouteActual Boolean   @default(false) @map("is_route_actual")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stops RouteStop[]

  @@unique([userId, slug], map: "routes_user_slug_unique")
  @@index([userId], map: "routes_user_id_idx")
  @@index([createdAt], map: "routes_created_at_idx")
  @@index([totalDistanceMeters], map: "routes_distance_idx")
  @@index([userId, createdAt], map: "routes_user_created_at_idx")
  @@map("routes")
}

model RouteStop {
  id      BigInt @id @default(autoincrement())
  routeId BigInt @map("route_id")

  name        String  @db.VarChar(200)
  address     String? @db.VarChar(500)
  cityName    String? @map("city_name") @db.VarChar(150)
  countryName String? @map("country_name") @db.VarChar(100)
  countryCode String? @map("country_code") @db.Char(2)

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)
  position  Int     @db.SmallInt

  description String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([routeId, position], map: "route_stops_route_position_unique")
  @@index([routeId], map: "route_stops_route_id_idx")
  @@index([countryCode], map: "route_stops_country_code_idx")
  @@index([cityName], map: "route_stops_city_name_idx")
  @@map("route_stops")
}
